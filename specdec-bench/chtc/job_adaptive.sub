# Override at submit time, e.g. condor_submit BENCHES=gsm8k,sum,qa RUN=adaptive_gsm8k_sum_qa job_adaptive.sub
if !defined BENCHES
  BENCHES = humaneval,alpaca,mt_bench
endif
if !defined RUN
  RUN = adaptive_three_bench
endif
if !defined SUITE
  SUITE = scripts/run_adaptive_suite.sh
endif
# GPU: regular expression on the device name, e.g. GPU=H200 to keep a comparison on one GPU type
if !defined GPU
  GPU = .
endif

universe = container
container_image = docker://pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

executable = job_adaptive.sh
arguments  = $(BENCHES) $(RUN) $(SUITE)
initial_dir = .

log    = logs/adaptive.$(Cluster).log
output = logs/adaptive.$(Cluster).out
error  = logs/adaptive.$(Cluster).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = job_adaptive.sh,.env,specdec-bench.tar.gz
transfer_output_files = results/$(RUN)

request_cpus   = 8
request_memory = 48GB
request_disk   = 80GB
request_gpus   = 1
requirements = (Target.CUDADriverVersion >= 12.4) && \
               (Target.GPUs_GlobalMemoryMb >= 40000) && \
               (Target.GPUs_Capability >= 8.0) && (Target.GPUs_Capability <= 9.0) && \
               !regexp("MIG", Target.GPUs_DeviceName) && \
               regexp("$(GPU)", Target.GPUs_DeviceName)

+WantGPULab   = true
+WantFlocking = false
+WantGlidein  = false
+GPUJobLength = "long"

queue 1