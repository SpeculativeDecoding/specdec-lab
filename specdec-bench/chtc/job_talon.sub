universe = container
container_image = docker://pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

executable = job_talon.sh
initial_dir = .

log    = logs/talon.$(Cluster).log
output = logs/talon.$(Cluster).out
error  = logs/talon.$(Cluster).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = job_talon.sh,.env,specdec-bench.tar.gz
transfer_output_files = results/talon_three_bench

request_cpus   = 8
request_memory = 48GB
request_disk   = 80GB
request_gpus   = 1
requirements = (Target.CUDADriverVersion >= 12.4) && \
               (Target.GPUs_GlobalMemoryMb >= 40000)

+WantGPULab   = true
+WantFlocking = false
+WantGlidein  = false
+GPUJobLength = "long"

queue 1